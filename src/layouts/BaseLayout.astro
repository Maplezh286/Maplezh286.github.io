---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeaderColorPicker from '../components/HeaderColorPicker.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  category?: string;
}

const {
  title = '正义风的博客空间',
  description = '记录软件开发、AI 学习与生活思考。',
  image = '/og.png',
  article = false,
  category,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteTitle = '正义风的博客空间';
const fullTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171817" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="正义风的博客空间" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{fullTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('jiangfeng-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;

        const headerColors = ['red', 'pink', 'purple', 'blue', 'cyan', 'teal', 'green', 'yellow', 'orange', 'brown', 'gray', 'black'];
        const savedHeaderColor = localStorage.getItem('jiangfeng-header-color');
        document.documentElement.dataset.headerColor = headerColors.includes(savedHeaderColor) ? savedHeaderColor : 'yellow';
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header activeCategory={category} />
    <main id="main-content"><slot /></main>
    <HeaderColorPicker />
    <Footer />
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('jiangfeng-theme', next);
        const frame = document.querySelector('iframe.giscus-frame');
        frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: next } } }, 'https://giscus.app');
      });

      const setHeaderColor = (color, save = false) => {
        document.documentElement.dataset.headerColor = color;
        document.querySelectorAll('[data-header-color-choice]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.headerColorChoice === color));
        });
        if (save) localStorage.setItem('jiangfeng-header-color', color);
      };

      setHeaderColor(document.documentElement.dataset.headerColor || 'yellow');
      document.querySelectorAll('[data-header-color-choice]').forEach((button) => {
        button.addEventListener('click', () => setHeaderColor(button.dataset.headerColorChoice, true));
      });
    </script>
  </body>
</html>
