---
import type { Post } from '../lib/blog';
import { categoryTitle, categoryUrl, formatDate, postUrl, readingTime } from '../lib/blog';

interface Props { posts: Post[]; compact?: boolean }
const { posts, compact = false } = Astro.props;
---

<div class:list={['post-list', { compact }]}>
  {posts.map((post) => (
    <article class="post-item">
      <div class="post-item-main">
        <div class="post-meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post.body)} 分钟阅读</span>
        </div>
        <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
        {!compact && <p>{post.data.description}</p>}
        <div class="post-taxonomy">
          <a href={categoryUrl(post.data.category)}>{post.data.category.map(categoryTitle).join(' / ')}</a>
          {post.data.tags.slice(0, 3).map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </div>
      <a class="post-arrow" href={postUrl(post)} aria-label={`阅读《${post.data.title}》`}>↗</a>
    </article>
  ))}
</div>
